MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@cryptosphere.local"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173
